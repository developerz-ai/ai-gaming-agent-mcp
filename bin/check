#!/usr/bin/env bash
# one-command check (typecheck + lint + test) — established by dz-runner setup mode. One command; adjust as the repo grows.
set -euo pipefail
# The app project (pyproject.toml + uv.lock) lives in apps/ai-gaming-agent-mcp: run uv there.
cd "$(dirname "$0")/../apps/ai-gaming-agent-mcp"
uv run ruff check src tests && uv run pytest tests/ --ignore=tests/integration -v
